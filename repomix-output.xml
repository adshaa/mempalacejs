# Add the mempalace repo to the path to import its modules
sys.path.insert(0, os.path.abspath('mempalace'))

def to_ts_regex_array(name, py_list):
    res = f"export const {name}: RegExp[] = [\n"
    for item in py_list:
        # Convert item to pattern string if it's a regex object
        pattern_str = item.pattern if isinstance(item, re.Pattern) else str(item)
        escaped = pattern_str.replace('\\', '\\\\').replace("'", "\\'")
        res += f"  /{escaped}/i,\n"
    res += "];\n"
    return res

def to_ts_string_set(name, py_set):
    res = f"export const {name}: Set<string> = new Set([\n"
    for item in sorted(list(py_set)):
        safe_item = item.replace("'", "\\'")
        res += f"  '{safe_item}',\n"
    res += "]);\n"
    return res

def to_ts_string_array(name, py_list):
    res = f"export const {name}: string[] = [\n"
    for item in py_list:
        # If it's a regex, get the pattern, otherwise str()
        item_str = item.pattern if isinstance(item, re.Pattern) else str(item)
        safe_item = item_str.replace("'", "\\'")
        res += f"  '{safe_item}',\n"
    res += "];\n"
    return res

def to_ts_dict(name, py_dict):
    res = f"export const {name}: Record<string, string[]> = {{\n"
    for k, v in py_dict.items():
        res += f"  '{k}': {json.dumps(v)},\n"
    res += "};\n"
    return res

